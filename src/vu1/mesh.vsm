    nop                                  | nop
    nop                                  | nop
    subaw.xyz acc, vf0, vf0w             | nop
    nop                                  | nop
    miniz.w vf16, vf16, vf9z             | nop
    madd.xyz vf17, vf31, vf16            | iaddiu vi2, vi0, 0x400
    nop                                  | iand vi11, vi10, vi2
    nop                                  | isub vi11, vi2, vi11
    maxx.w vf16, vf16, vf0x              | nop
    clipw.xyz vf17, vf0w                 | nop
    nop                                  | lq.xyzw vf14, 7(vi5)
    nop                                  | nop
    ftoi4.xyzw vf16, vf16                | mfp.w vf22, p
