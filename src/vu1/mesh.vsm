    nop                                  | ior vi1, vi1, vi2
    nop                                  | isw.w vi1, 2(vi6)
    mul.yz vf26, vf18, vf22              | ibne vi3, vi0, atan_store
    nop                                  | sq.xyz vf16, 2(vi6)
    nop                                  | nop
    mulax.x acc, vf18, vf22x             | nop
    madday.x acc, vf1, vf26y             | nop
    maddz.x vf26, vf1, vf26z             | nop
    add.xyz vf18, vf18, vf18             | nop
    nop                                  | nop
    nop                                  | nop
    nop                                  | nop
    mulax.xyz acc, vf18, vf26x           | nop
    msub.xyz vf18, vf1, vf22             | nop
    nop                                  | nop
    nop                                  | nop
    nop                                  | nop
    abs.xyzw vf26, vf18                  | nop
    subz.xyzw vf0, vf26, vf26z           | nop
    nop                                  | nop
    nop                                  | nop
    nop                                  | iaddiu vi2, vi0, 0x80
    nop                                  | fmand vi1, vi2
    nop                                  | nop
    nop                                  | ibne vi1, vi0, atan_xy
    nop                                  | nop
    nop                                  | eatanxz.xz p, vf26 ; P = atan(z/x)
    sub.xyzw vf0, vf18, vf0              | nop
    nop                                  | nop
    nop                                  | nop
    nop                                  | iaddiu vi2, vi0, 0x20
    nop                                  | fmand vi1, vi2
    nop                                  | nop
    nop                                  | nop
    nop                                  | iaddiu vi2, vi0, 0x80
    nop                                  | fmand vi3, vi2
    nop                                  | waitp
    nop                                  | mfp.x vf18, p
    nop                                  | nop
    nop                                  | nop
    nop                                  | nop
    muly.x vf18, vf18, vf9y              | nop
    nop                                  | nop
    nop                                  | nop
    nop                                  | nop
    nop                                  | b atan_sign
    nop                                  | nop
atan_xy:
    addx.y vf26, vf0, vf26x              | nop
    addz.x vf26, vf0, vf26z              | nop
    nop                                  | nop
    nop                                  | nop
    nop                                  | nop
    nop                                  | eatanxy.xy p, vf26 ; P = atan(y/x)
    subx.xyzw vf0, vf18, vf0x            | nop
    nop                                  | nop
    nop                                  | nop
    nop                                  | iaddiu vi2, vi0, 0x20
    nop                                  | fmand vi1, vi2
    nop                                  | nop
    nop                                  | nop
    nop                                  | iaddiu vi2, vi0, 0x80
    nop                                  | fmand vi3, vi2
    nop                                  | waitp
    nop                                  | mfp.x vf18, p
    nop                                  | nop
    nop                                  | nop
    nop                                  | nop
    mulay.x acc, vf18, vf9y              | nop
    msubw.x vf18, vf1, vf9w              | nop
    nop                                  | nop
    nop                                  | nop
    nop                                  | nop
    sub.x vf18, vf0, vf18                | nop
    nop                                  | nop
    nop                                  | nop
atan_sign:
    nop                                  | ibeq vi3, vi0, atan_sign2
    nop                                  | nop
    sub.x vf18, vf1, vf18                | nop
    nop                                  | nop
    nop                                  | nop
    nop                                  | nop
atan_sign2:
    nop                                  | ibeq vi1, vi0, atan_scale
    nop                                  | nop
    sub.x vf18, vf0, vf18                | nop
    nop                                  | nop
atan_scale:
    mulaw.xy acc, vf18, vf9w             | nop
