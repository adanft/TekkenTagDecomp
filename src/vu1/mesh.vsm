    nop                                  | nop
    nop                                  | ibeq vi1, vi0, atan_store
    nop                                  | nop
    addw.x vf24, vf24, vf0w              | nop
atan_store:
    mulq.xyz vf24, vf24, q               | iaddiu vi5, vi5, 0x4
