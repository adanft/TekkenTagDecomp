; VU1 program 0x032: loads the per-object constants from TOP into registers.
; Called by  MSCAL 0x32 in the VIF1 template at 0x46B160 (render_fighter_a, func at 0x341C24 and 0x34220C) [V]
;   TOP+0..3   vf10..vf13  local -> screen matrix
;   TOP+4..6   vf2..vf4    light directions in local space
;   TOP+8..11  vf5..vf8    light colour matrix (vf8: ambient); vf5.w, vf6.w: fog = vf5.w * w + vf6.w;
;                          vf7.w goes to vf31.z (depth scale)
;   TOP+12..14 vf28..vf30  environment map matrix;  TOP+15 vf21 eye position in local space
;   (lattice.vsm reads vf5..vf8, vf28..vf30, vf21 as the eight corners of its lattice instead)
; vi7 = 0x306: the first xgkick of the next batch program sends the buffer at 0x306 [I].

.mpg 0x32
    nop                                  | xtop vi5          ; vi5 = TOP
    nop                                  | lq.xyzw vf10, 0(vi5)
    nop                                  | lq.xyzw vf11, 1(vi5)
    nop                                  | lq.xyzw vf12, 2(vi5)
    nop                                  | lq.xyzw vf13, 3(vi5)
    nop                                  | lq.xyzw vf2, 4(vi5)
    nop                                  | lq.xyzw vf3, 5(vi5)
    nop                                  | lq.xyzw vf4, 6(vi5)
    nop                                  | lq.xyzw vf5, 8(vi5)
    nop                                  | lq.xyzw vf6, 9(vi5)
    nop                                  | lq.xyzw vf7, 10(vi5)
    nop                                  | lq.xyzw vf8, 11(vi5)
    nop                                  | lq.xyzw vf28, 12(vi5)
    nop                                  | lq.xyzw vf29, 13(vi5)
    addw.z vf31, vf0, vf7w               | lq.xyzw vf30, 14(vi5) ; vf31.z = vf7.w
    nop                                  | lq.xyzw vf21, 15(vi5)
    nop                                  | iaddiu vi7, vi0, 0x306 ; first kick address
    nop                                  | nop [E]
    nop                                  | nop
