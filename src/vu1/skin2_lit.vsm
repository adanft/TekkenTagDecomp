    ftoi0.xyzw vf20, vf19                | nop
    nop                                  | nop
    nop                                  | nop
    ftoi4.xyzw vf17, vf16                | nop
    nop                                  | nop
    nop                                  | sq.xyzw vf22, 0(vi6)
