; VU0 program 0x0EA (vcallms 0x750): skinned vertex, specular highlight only (gloss pass [I]).
; Caller      func_003437B8 [V]
;
; VU0 calling convention (the EE loops func_003435C0, func_003436B8, func_003437B8, func_003438B8 [V]):
;   one vertex per vcallms; the EE loads the vertex record (address a1) into registers first:
;     +0x00            vf7    copied to the output as is (ST), except by the environment map program
;     +0x10..+0x1C     vi2..vi5  VU0 data addresses (quadwords) of up to four bone blocks; a 0 ends the list
;     +0x20 + 0x20*i   vf2..vf5   influence i: normal, already scaled by its weight [I]
;     +0x30 + 0x20*i   vf26..vf29 influence i: position, w = weight [I]
;   vf8..vf11  light colour matrix (3 light colours and the ambient row), loaded once per model (0x34346C)
;   vf6, vi6   specular parameters (func_003436B8, func_003437B8 only): vf6.x intensity, vi6 & 0xFF exponent steps
;   results    vf20 RGBA (integers), vf22 XYZF (12.4 fixed point; w = 0x8000 when the triangle is not drawn),
;              written by the EE after the call as three quadwords (ST, RGBA, XYZF2) of a GIF packet
; VU0 data memory (quadwords, vi0-relative) [I from the loads; written by the EE, e.g. func_00342E38]:
;   0  vf31: x, y, z scale to the guard band [-1, 1]; w = 255 (colour clamp)
;   1  w: the word stored in XYZF.w when the triangle is clipped (ADC, bit 15)
;   4..7   world -> screen matrix (gloss program)
;   8..10  light directions in world space; 11 eye vector
;   252..255  environment map matrix (D_00433400, copied by the EE at 0x343444 [V])
;   bone block: rows 0..3 bone -> screen, rows 4..7 bone -> world, rows 8..10 light directions in bone space
;
; The first part, common to the four programs, blends up to four bones: for each bone block vi2..vi5 (stopping at
; the first 0) it adds
;   rows 4..6 (bone -> world) * normal_i to vf25
;   rows 4..7 (bone -> world) * position_i to vf22 (vf21 holds the pending term)
; vf1 = (1, 1, 1, 1) and vf21 = 0 are set on the way.
;
; Then the world position is transformed by memory 4..7 (world -> screen). The colour is only the highlight
; (vf8 * vf6.x * spec^(2^n), same reflection term as skin_specular) [I]; a vertex facing away is not drawn.

.mpg 0xea
    mulx.xyzw vf1, vf0, vf0x             | lq.xyzw vf12, 4(vi2)
    nop                                  | lq.xyzw vf13, 5(vi2)
    nop                                  | lq.xyzw vf14, 6(vi2)
    mulx.xyzw vf21, vf0, vf0x            | lq.xyzw vf15, 4(vi2)
    mulax.xyzw acc, vf12, vf2x           | lq.xyzw vf16, 5(vi2)
    madday.xyzw acc, vf13, vf2y          | lq.xyzw vf17, 6(vi2)
    maddz.xyzw vf25, vf14, vf2z          | lq.xyzw vf18, 7(vi2)
    mulax.xyzw acc, vf15, vf26x          | lq.xyzw vf12, 4(vi3)
    madday.xyzw acc, vf16, vf26y         | lq.xyzw vf13, 5(vi3)
    maddaz.xyzw acc, vf17, vf26z         | ibeq vi3, vi0, blend_done
    maddw.xyzw vf22, vf18, vf26w         | lq.xyzw vf14, 6(vi3)
    nop                                  | lq.xyzw vf15, 4(vi3)
    mulax.xyzw acc, vf12, vf3x           | lq.xyzw vf16, 5(vi3)
    madday.xyzw acc, vf13, vf3y          | lq.xyzw vf17, 6(vi3)
    maddz.xyzw vf19, vf14, vf3z          | lq.xyzw vf18, 7(vi3)
    mulax.xyzw acc, vf15, vf27x          | lq.xyzw vf12, 4(vi4)
    madday.xyzw acc, vf16, vf27y         | lq.xyzw vf13, 5(vi4)
    maddaz.xyzw acc, vf17, vf27z         | lq.xyzw vf14, 6(vi4)
    add.xyzw vf25, vf25, vf19            | ibeq vi4, vi0, blend_done
    maddw.xyzw vf21, vf18, vf27w         | nop
    mulax.xyzw acc, vf12, vf4x           | lq.xyzw vf15, 4(vi4)
    madday.xyzw acc, vf13, vf4y          | lq.xyzw vf16, 5(vi4)
    maddz.xyzw vf19, vf14, vf4z          | lq.xyzw vf17, 6(vi4)
    add.xyzw vf22, vf22, vf21            | lq.xyzw vf18, 7(vi4)
    mulax.xyzw acc, vf15, vf28x          | lq.xyzw vf12, 4(vi5)
    madday.xyzw acc, vf16, vf28y         | lq.xyzw vf13, 5(vi5)
    maddaz.xyzw acc, vf17, vf28z         | lq.xyzw vf14, 6(vi5)
    add.xyzw vf25, vf25, vf19            | ibeq vi5, vi0, blend_done
    maddw.xyzw vf21, vf18, vf28w         | nop
    mulax.xyzw acc, vf12, vf5x           | lq.xyzw vf15, 4(vi5)
    madday.xyzw acc, vf13, vf5y          | lq.xyzw vf16, 5(vi5)
    maddz.xyzw vf19, vf14, vf5z          | lq.xyzw vf17, 6(vi5)
    add.xyzw vf22, vf22, vf21            | lq.xyzw vf18, 7(vi5)
    mulax.xyzw acc, vf15, vf29x          | nop
    madday.xyzw acc, vf16, vf29y         | nop
    add.xyzw vf25, vf25, vf19            | nop
    maddaz.xyzw acc, vf17, vf29z         | nop
    maddw.xyzw vf21, vf18, vf29w         | nop
blend_done:
    addw.xyzw vf1, vf1, vf0w             | lq.xyzw vf12, 8(vi0)
    mulx.w vf3, vf0, vf0x                | lq.xyzw vf13, 9(vi0)
    mul.yz vf2, vf25, vf25               | lq.xyzw vf14, 10(vi0)
    add.xyzw vf24, vf22, vf21            | lq.xyzw vf15, 4(vi0) ; world position
    mulax.xyzw acc, vf12, vf25x          | lq.xyzw vf16, 5(vi0)
    madday.xyzw acc, vf13, vf25y         | lq.xyzw vf17, 6(vi0)
    maddz.xyz vf20, vf14, vf25z          | lq.xyzw vf18, 7(vi0) ; N.L (world lights)
    mulax.x acc, vf25, vf25x             | lq.xyzw vf26, 11(vi0)
    madday.x acc, vf1, vf2y              | loi 0x43000000 [I]   ; 128
    maddz.x vf2, vf1, vf2z               | iaddiu vi8, vi0, 0x80
    mulax.xyzw acc, vf15, vf24x          | fmand vi7, vi8    ; MAC sign of N.L0
    madday.xyzw acc, vf16, vf24y         | ibne vi7, vi0, facing_away ; light 0 behind: not drawn
    maddaz.xyzw acc, vf17, vf24z         | nop
    maddw.xyzw vf22, vf18, vf0w          | nop               ; world -> screen (memory 4..7)
    nop                                  | nop
    nop                                  | rsqrt q, vf0w, vf2x
    nop                                  | nop
    nop                                  | lq.xyzw vf31, 0(vi0)
    nop                                  | iadd vi9, vi0, vi6
    mulx.xyzw vf20, vf0, vf0x            | nop               ; colour = 0 until the highlight
    nop                                  | nop
    nop                                  | nop
    nop                                  | nop
    ftoi0.xyzw vf20, vf20                | nop
    nop                                  | nop
    nop                                  | nop
    nop                                  | nop
    nop                                  | nop
    mulq.xyz vf25, vf25, q               | div q, vf0w, vf22w
    nop                                  | nop
    sub.w vf22, vf22, vf7                | nop
    nop                                  | move.z vf7, vf22
    mul.yz vf16, vf25, vf26              | nop
    nop                                  | nop
    add.xyz vf17, vf25, vf25             | nop
    mulax.x acc, vf25, vf26x             | div q, vf0w, vf22w
    madday.x acc, vf1, vf16y             | nop
    maddz.x vf16, vf1, vf16z             | nop
    nop                                  | move.w vf22, vf0
    mulq.xyz vf22, vf22, q               | nop
    suba.xyz acc, vf0, vf26              | nop
    maddx.xyz vf16, vf17, vf16x          | nop               ; R = 2 (N.E) N - E
    subaw.xyz acc, vf0, vf0w             | nop
    madd.xyz vf23, vf22, vf31            | nop
    mulq.z vf22, vf7, q                  | nop
    mulax.x acc, vf12, vf16x             | nop
    madday.x acc, vf13, vf16y            | iaddiu vi7, vi0, 0xff
    maddz.x vf24, vf14, vf16z            | iand vi9, vi6, vi7 ; R.L0
    clipw.xyz vf23, vf0w                 | isubiu vi9, vi9, 0x1
    ftoi4.xyzw vf22, vf22                | nop
    nop                                  | nop
    mul.x vf24, vf24, vf24               | fmand vi7, vi8
    nop                                  | fcand vi1, 0x3ffff
    nop                                  | ibne vi1, vi0, hide
    nop                                  | nop
    nop                                  | ibne vi7, vi0, done
    mulx.xyzw vf2, vf8, vf6x             | nop               ; vf2 = light colour 0 * vf6.x
    nop                                  | ibeq vi9, vi0, spec_colour
    nop                                  | nop
spec_pow:
    mul.x vf24, vf24, vf24               | isubiu vi9, vi9, 0x1 ; spec^(2^n)
    nop                                  | nop
    nop                                  | ibne vi9, vi0, spec_pow
    nop                                  | nop
spec_colour:
    mulx.xyz vf19, vf2, vf24x            | nop               ; colour = vf2 * spec
    nop                                  | nop
    nop                                  | nop
    muli.w vf20, vf0, i                  | nop
    miniw.xyz vf20, vf19, vf31w          | nop
    nop                                  | nop
    nop                                  | nop
    nop                                  | nop
    ftoi0.xyzw vf20, vf20                | nop
    nop                                  | nop
    nop                                  | nop [E]
    nop                                  | nop
facing_away:
    clipw.xyz vf15, vf0w                 | nop
hide:
    nop                                  | lq.w vf22, 1(vi0) ; ADC: do not draw
    nop                                  | nop
done:
    nop                                  | nop [E]
    nop                                  | nop
